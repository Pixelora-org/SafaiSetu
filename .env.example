# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Site URL for OAuth redirects and share cards
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Access Control
# Comma-separated email addresses that can access /admin moderation queue
# Alternative: Set app_metadata.role = "admin" in Supabase Auth dashboard
ADMIN_EMAILS=you@example.com,admin@example.com

